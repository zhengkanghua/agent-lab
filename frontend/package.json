{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "dev:shots": "node scripts/dev-screenshot.mjs",
    "dev:audit": "node scripts/dev-audit.mjs"
  },
  "dependencies": {
    "@crazydos/vue-markdown": "^1.1.4",
    "@lucide/vue": "^1.31.0",
    "@tanstack/vue-query": "^5.101.4",
    "radix-vue": "^1.9.17",
    "remark-gfm": "^4.0.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
