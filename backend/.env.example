DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/news_vector_lc
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT=5
DATABASE_HEALTH_CHECK_TIMEOUT=5
DATABASE_TIMEZONE=UTC
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# 浏览器登录 Cookie 的名称。登录成功后浏览器会保存名为 news_auth 的 HttpOnly Cookie；
# 前端 JavaScript 无法读取它。修改名称后，旧名称的 Cookie 将不再被后端识别，用户需要重新登录。
AUTH_COOKIE_NAME=news_auth

# 是否只允许浏览器通过 HTTPS 发送登录 Cookie。生产环境必须为 true，防止 Cookie 经明文
# HTTP 传输；只有使用 http://127.0.0.1 等本地 HTTP 联调时才设置为 false。
AUTH_COOKIE_SECURE=true

# Cookie 的 SameSite 策略。strict 表示跨站请求不会携带登录 Cookie，可降低 CSRF 风险；
# 当前前后端使用同域 /api，推荐保持 strict。可选值只有 strict 或 lax。
AUTH_COOKIE_SAMESITE=strict

# 单次登录会话的有效期，单位为秒；28800 秒等于 8 小时。该值同时约束浏览器 Cookie
# 和 PostgreSQL access_tokens 的有效期，过期后必须重新登录。
AUTH_SESSION_LIFETIME_SECONDS=28800

# 可选的唯一“保底超级管理员”。复制到本地 .env 后同时取消下面两行注释并替换占位值；
# 服务启动时会创建或同步该账号。模板故意不提供可直接使用的默认密码。
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ADMIN_PASSWORD=<replace-with-a-random-12-to-128-character-secret>

# FreshRSS API credentials. Add real values to your local .env.
FRESHRSS_PROVIDER_KEY=freshrss_main
FRESHRSS_API_BASE_URL=https://freshrss.example.com/api/
FRESHRSS_USERNAME=
FRESHRSS_API_PASSWORD=
FRESHRSS_REQUEST_TIMEOUT_SECONDS=15
FRESHRSS_VERIFY_SSL=true
# JSON array of FreshRSS categories that this service is allowed to synchronize.
FRESHRSS_SYNC_CATEGORIES=["新闻","财经","宏观数据"]

# Ollama Embedding 服务。模板中的密钥有意留空；真实密钥只填写到已被忽略的 .env。
OLLAMA_BASE_URL=https://ollama.example.com
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
OLLAMA_API_KEY=
# 批量生成文档向量可能比普通 API 请求慢，因此单独配置较长的请求超时。
OLLAMA_EMBEDDING_REQUEST_TIMEOUT_SECONDS=120
# 第一版使用保守批量大小；必须根据服务端吞吐、显存和超时情况测量后再调整。
OLLAMA_EMBEDDING_BATCH_SIZE=16

# Qdrant 向量存储。应用读写只使用 current Alias，物理 Collection 名由以下参数组合。
QDRANT_BASE_URL=https://qdrant.example.com
QDRANT_API_KEY=
QDRANT_REQUEST_TIMEOUT_SECONDS=30
QDRANT_ENVIRONMENT=langchain
QDRANT_COLLECTION_SCHEMA_VERSION=v1
QDRANT_COLLECTION_GENERATION=1
QDRANT_WRITE_BATCH_SIZE=64
# 阶段 2 已由真实 bge-m3:567m 响应确认 1024 维；写入前仍会核对实际向量长度。
QDRANT_VECTOR_DIMENSION=1024
# 当前新闻语义检索空间固定使用 Cosine；修改 Distance 必须新建 Schema/Collection。
QDRANT_DISTANCE=Cosine
