# ============================================================
# 本文件同时是两种场景的模板，照抄时按场景取舍：
#
#   本地开发   复制成 backend/.env，DATABASE_URL 指本地或远程库，
#              AUTH_COOKIE_SECURE=false（本地是 HTTP），忽略下面「容器部署专属」那一节。
#   容器部署   复制成服务器上 /opt/agent-lab/.env（与 docker-compose.yml 同目录），
#              AUTH_COOKIE_SECURE 必须 true，并填好「容器部署专属」那一节。
#              权限设 chmod 600，属主设为部署用户。步骤见 docs/container_deployment.md。
#
# 加新配置项时改这一个文件即可，仓库里没有第二份 env 模板。
# ============================================================

# ---------- 容器部署专属（本地开发用不到，留着也不影响：配置类均为 extra="ignore"）----------

# 后端容器映射到宿主机的端口，只被 docker-compose.yml 读取。容器内 uvicorn 固定听 8000，
# 这里改的是宿主机那一侧；反代（OpenResty）指向的就是这个端口。
# 本地开发不用它，本地端口由 uvicorn --port 参数决定。
BACKEND_PORT=18000

# 容器时区，只影响 docker logs 里时间戳的显示。数据库时区由下面的 DATABASE_TIMEZONE
# 单独决定，两者互不干涉，不要为了「统一」把 DATABASE_TIMEZONE 也改成本地时区。
TZ=Asia/Shanghai

# 后端镜像地址。容器部署时**必须填**：docker-compose.yml 不再提供默认值（本仓库公开，
# registry 地址不写进代码），缺了它 compose 会直接报错退出。
#
# ⚠ 必须和 CI 推送的地址完全一致。CI 那边由 GitHub Variables 的 ACR_REGISTRY /
# ACR_NAMESPACE / ACR_REPOSITORY 拼成，和本文件是两个互相看不见的地方，没法自动比对；
# 不一致的表现是「CI 全绿、容器也重启了，但跑的还是上一版代码」，很难查。
# 格式：<registry>/<namespace>/<repository>:backend-latest
#
# 注意这里只有地址、没有密码。ACR 的固定密码不放本文件——CI 用 GitHub Secrets 里的
# ACR_PASSWORD，服务器由部署脚本每次 docker login 时从标准输入喂进去。
BACKEND_IMAGE=<your-acr-registry>/<your-namespace>/agent-lab:backend-latest

# ---------- 应用配置（本地开发与容器部署都需要）----------

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/news_vector_lc
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT=5
DATABASE_HEALTH_CHECK_TIMEOUT=5
DATABASE_TIMEZONE=UTC
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# 浏览器登录 Cookie 的名称。登录成功后浏览器会保存名为 news_auth 的 HttpOnly Cookie；
# 前端 JavaScript 无法读取它。修改名称后，旧名称的 Cookie 将不再被后端识别，用户需要重新登录。
AUTH_COOKIE_NAME=news_auth

# 是否只允许浏览器通过 HTTPS 发送登录 Cookie。生产环境必须为 true，防止 Cookie 经明文
# HTTP 传输；只有使用 http://127.0.0.1 等本地 HTTP 联调时才设置为 false。
AUTH_COOKIE_SECURE=true

# Cookie 的 SameSite 策略。strict 表示跨站请求不会携带登录 Cookie，可降低 CSRF 风险；
# 当前前后端使用同域 /api，推荐保持 strict。可选值只有 strict 或 lax。
AUTH_COOKIE_SAMESITE=strict

# 单次登录会话的有效期，单位为秒；28800 秒等于 8 小时。该值同时约束浏览器 Cookie
# 和 PostgreSQL access_tokens 的有效期，过期后必须重新登录。
AUTH_SESSION_LIFETIME_SECONDS=28800

# 可选的唯一“保底超级管理员”。复制到本地 .env 后同时取消下面两行注释并替换占位值；
# 服务启动时会创建或同步该账号。模板故意不提供可直接使用的默认密码。
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ADMIN_PASSWORD=<replace-with-a-random-12-to-128-character-secret>

# FreshRSS API credentials. Add real values to your local .env.
FRESHRSS_PROVIDER_KEY=freshrss_main
FRESHRSS_API_BASE_URL=https://freshrss.example.com/api/
FRESHRSS_USERNAME=
FRESHRSS_API_PASSWORD=
FRESHRSS_REQUEST_TIMEOUT_SECONDS=15
FRESHRSS_VERIFY_SSL=true
# JSON array of FreshRSS categories that this service is allowed to synchronize.
FRESHRSS_SYNC_CATEGORIES=["新闻","财经","宏观数据"]

# Ollama Embedding 服务。模板中的密钥有意留空；真实密钥只填写到已被忽略的 .env。
OLLAMA_BASE_URL=https://ollama.example.com
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
OLLAMA_API_KEY=
# 批量生成文档向量可能比普通 API 请求慢，因此单独配置较长的请求超时。
OLLAMA_EMBEDDING_REQUEST_TIMEOUT_SECONDS=120
# 第一版使用保守批量大小；必须根据服务端吞吐、显存和超时情况测量后再调整。
OLLAMA_EMBEDDING_BATCH_SIZE=16

# Qdrant 向量存储。应用读写只使用 current Alias，物理 Collection 名由以下参数组合。
QDRANT_BASE_URL=https://qdrant.example.com
QDRANT_API_KEY=
QDRANT_REQUEST_TIMEOUT_SECONDS=30
QDRANT_ENVIRONMENT=langchain
QDRANT_COLLECTION_SCHEMA_VERSION=v1
QDRANT_COLLECTION_GENERATION=1
QDRANT_WRITE_BATCH_SIZE=64
# 阶段 2 已由真实 bge-m3:567m 响应确认 1024 维；写入前仍会核对实际向量长度。
QDRANT_VECTOR_DIMENSION=1024
# 当前新闻语义检索空间固定使用 Cosine；修改 Distance 必须新建 Schema/Collection。
QDRANT_DISTANCE=Cosine

# 生成式 LLM，只被 Agent 对话（/agent/*）使用。它和上面的 Embedding 是两件事：Embedding
# 把文本变成向量用于比较距离，这里的模型产出文字。留空 LLM_API_KEY 时只有 /agent/* 返回
# 503，检索接口照常工作。模板中的密钥有意留空；真实密钥只填写到已被忽略的 .env。
# 接入方式，只能是 openai_compatible 或 ollama；决定用哪个客户端类、认证怎么带。
LLM_PROVIDER=openai_compatible
# 模型 API 根地址。OpenAI 兼容中转站通常需要带 /v1 后缀；ollama 分支填 Ollama 服务根地址。
LLM_BASE_URL=https://api.openai.com/v1
# openai_compatible 分支必须非空，ollama 分支允许为空。
LLM_API_KEY=
# 必须是所配 LLM_BASE_URL 那一侧真实存在的模型名。
LLM_MODEL=gpt-4o-mini
# 主模型连续失败后降级使用；允许与 LLM_MODEL 相同，此时降级只等于多一次重试。
LLM_FALLBACK_MODEL=gpt-4o-mini
# 采样温度，范围 0..2。新闻问答要求可复现且少编造，所以默认 0。
LLM_TEMPERATURE=0.0
# 单次模型 HTTP 请求的总超时秒数，不是整个运行（run）的时长上限。
LLM_REQUEST_TIMEOUT_SECONDS=60
# 调用模型时发送的 User-Agent；留空表示沿用底层 SDK 的默认值。
# 需要这个开关是因为部分中转站按 User-Agent 拦通用 SDK 流量：openai SDK 默认发的
# "OpenAI/Python x.y.z" 会被判 403（消息形如 "Your request was blocked."，错误码
# llm_request_blocked），同一个 Key 换个标识就能正常调用。默认值如实署名本项目。
LLM_USER_AGENT=agent-lab
# 会话记忆专用连接池上限（与 DATABASE_POOL_SIZE 是两套独立连接）刻意不在这里开放：
# LlmSettings.checkpoint_pool_size 声明为 strict=True，而环境变量取到的一律是字符串，
# 所以设置 LLM_CHECKPOINT_POOL_SIZE=4 会在启动时直接 ValidationError。要改就改
# config/llm.py 里的默认值 4。
# 这一条对三种注入方式都成立，没有例外：dotenv 文件、systemd 的 EnvironmentFile、
# 以及 docker compose 的 env_file——它们送进来的都是字符串。

# LangSmith 运行轨迹追踪，默认关闭。键名刻意对齐 LangSmith 官方环境变量，但本项目用
# pydantic-settings 读 .env、不写 os.environ，所以改这些值需要重启进程才生效。
# 开启意味着提问内容和检索到的新闻正文会离开本机、发往境外云服务，请先确认这是你要的。
LANGSMITH_TRACING=false
# LANGSMITH_TRACING=true 时必须非空，否则追踪静默失败。
LANGSMITH_API_KEY=
# 轨迹归属的项目名；项目不存在时由 LangSmith 侧自动创建。
LANGSMITH_PROJECT=agent-lab
# 自托管 LangSmith 时改这里。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
