# 隔离验收镜像：只用于 Linux prefork/Redis/PostgreSQL 测试，不发布。
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends redis-server \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/backend
ENV UV_FROZEN=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --all-groups --no-install-project
COPY src/ ./src/
COPY tests/ ./tests/
COPY alembic/ ./alembic/
COPY alembic.ini ./
RUN uv sync --frozen --all-groups
CMD ["uv", "run", "--no-sync", "pytest", "-q", "--tb=short", "--basetemp=.pytest_cache/task-processes", "tests/test_task_queue_integration.py", "tests/test_task_migration_postgres_integration.py", "tests/test_task_handoff_postgres_integration.py", "tests/test_scheduler_postgres_integration.py"]
